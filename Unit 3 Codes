class Solution {
public:
    int climbStairs(int n) {
    
        if (n <= 2) return n;
         int prev1 = 1, prev2 = 2; // ways(1), ways(2)
        for (int i = 3; i <= n; i++) {
          int current = prev1 + prev2;
          prev1 = prev2;
          prev2 = current;
    } 
 return prev2;
    }
};

EXPERIMENT 3.1.2 (FROG JUMP)
CODES;

class Solution {
public:
    bool canCross(vector<int>& stones) {
        int n = stones.size();
        
        unordered_map<int, unordered_set<int>> dp;
        dp[0].insert(0);
        for (int stone : stones) {
            for (int k : dp[stone]) {
                for (int jump = k - 1; jump <= k + 1; jump++) {
                    if (jump > 0) {
                        int nextStone = stone + jump;
                        dp[nextStone].insert(jump);
                    }
                }
            }
        }
        return !dp[stones[n - 1]].empty();
    }
};


